PassengerEnabled On
PassengerAppRoot /opt/lampp/htdocs/new_Simple_LB
PassengerPython /usr/bin/python3

# ── Security: Block direct access to sensitive files ──────────────
<FilesMatch "\.(env|db|sqlite|py|pyc|pyo|cfg|ini|log|sh|bak|sql|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block .git directory access
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^__pycache__/ - [F,L]
    RewriteRule ^uploads/.*\.(py|php|sh|rb|pl|cgi|exe)$ - [F,L]
</IfModule>

# ── Security: Prevent clickjacking on Apache level ────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Disable directory listing ─────────────────────────────────────
Options -Indexes
